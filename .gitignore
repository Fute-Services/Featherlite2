# --- app/ (Android) -------------------------------------------------------
# Everything below is regenerated by the app build; see app/README.md.
app/www/
app/offline/
app/android/build/
app/android/app/build/
app/android/.gradle/
app/android/local.properties
app/android/app/src/main/assets/public/
app/android/app/src/main/assets/capacitor.config.json
app/android/app/src/main/assets/capacitor.plugins.json
app/resources/

# Signing material. This repo is public, so a release key must never be
# committed - leaking one lets anyone ship an "update" to the installed app.
# The debug keystore is the exception: it holds the standard, publicly known
# Android debug credentials and is committed on purpose so every build signs
# with the same key.
app/keystore/*
!app/keystore/debug.keystore
*.jks
