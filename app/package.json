{
  "name": "featherlite-signature-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Featherlite Signature - offline Android app (Capacitor shell around the web build)",
  "scripts": {
    "offline:fetch": "node scripts/fetch-offline-assets.mjs",
    "offline:location": "node scripts/mirror-location-tour.mjs",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --iconBackgroundColor #000000 --iconBackgroundColorDark #000000 --splashBackgroundColor #000000 --splashBackgroundColorDark #000000",
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap copy android && cap update android",
    "apk": "npm run sync && node scripts/build-apk.mjs release",
    "apk:debug": "npm run sync && node scripts/build-apk.mjs debug",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/status-bar": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.4",
    "sharp": "^0.35.3"
  }
}
